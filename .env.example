NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# AI API KEYS
GEMINI_API_KEY=
GROQ_API_KEY=

# Auth (Supabase)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GAS (Google Apps Script)
GAS_SHARED_SECRET=replace-with-random-64-char-string
GAS_WEBAPP_URL=
GOOGLE_ADMIN_EMAIL=

# Receipt OCR service (server-side only)
RECEIPT_OCR_SERVICE_URL=http://python-ocr-service:8000/api/ocr
RECEIPT_OCR_TIMEOUT_MS=35000
RECEIPT_OCR_MAX_UPLOAD_BYTES=10485760

# Turnstile (Cloudflare)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Custom application settings
FORCE_AUTH_DISABLED=false
FORCE_OFFLINE_MODE=false

# Mode Kepemilikan Spreadsheet (Storage Ownership Mode)
# false = Mode 1 (Klasik / Stabil): Semua data tersimpan di Google Sheet admin, tanpa banner atau delegasi Google Drive pribadi.
# true  = Mode 2 (Enhanced): Fitur transfer kepemilikan Google Drive pribadi diaktifkan untuk semua pengguna.
# email@example.com = Mode Canary: Diaktifkan hanya untuk akun pengujian tertentu (dipisah koma jika lebih dari satu).
ENABLE_PERSONAL_STORAGE=false

# Local Development Dummy User (Used when FORCE_AUTH_DISABLED=true)
DEV_USER_ID=dev-local-user-id
DEV_USER_EMAIL=dev@local.test
DEV_USER_NAME="Developer"
DEV_USER_AVATAR_URL=
# Or pass the full raw Supabase JSON string:
# DEV_USER_JSON=
